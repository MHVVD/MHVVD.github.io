---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SERIES } from '../../data/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf(),
);
const bySeries = Object.entries(SERIES)
  .map(([key, s]) => ({ key, ...s, count: posts.filter((p) => p.data.series === key).length }))
  .filter((s) => s.count > 0);
---

<Base
  title="Writing"
  description="Writing by Mahmud Lawal — technical notes on robotics, AI, and the ideas I'm working through."
>
  <div class="container page">
    <header class="page-head">
      <p class="label">Writing{bySeries.map((s) => <span> · {s.title}</span>)}</p>
      <h1>Notes on robotics &amp; AI</h1>
      <p>{bySeries[0]?.blurb ?? 'Technical notes on robotics and AI.'}</p>
    </header>

    <h2 class="visually-hidden">All posts</h2>
    <PostList posts={posts} showTags />
  </div>
</Base>

<style>
  .page { padding-block: clamp(40px, 7vw, 80px) 40px; }
  .page-head { max-width: 720px; margin-bottom: 40px; }
  .page-head h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem); letter-spacing: -0.025em; margin: 10px 0 12px; }
  .page-head p:last-child { color: var(--text-2); font-size: 1.125rem; margin: 0; }
</style>
