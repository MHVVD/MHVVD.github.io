---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Credentials from '../components/Credentials.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../data/site';
import { highlights, facts, projects, skills } from '../data/profile';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf())
  .slice(0, 3);

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="label">{SITE.role} · {SITE.location}</p>
      <h1 id="hero-title">Mahmud Lawal</h1>
      <p class="hero__lede">
        I build end-to-end autonomous systems — from control algorithms and computer-vision
        pipelines to edge-deployed models that run in the real world. Mechatronics by training,
        AI by obsession.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#work">Selected work <Fragment set:html={arrow} /></a>
        <a class="btn" href="/blog/">Writing</a>
        <a class="btn" href={SITE.links.email}>Email</a>
      </div>
      <ul class="hero__links" aria-label="Profiles">
        <li><a href={SITE.links.github} rel="noopener">GitHub <span class="mono">/MHVVD</span></a></li>
        <li><a href={SITE.links.linkedin} rel="noopener">LinkedIn <span class="mono">/mahmud-lawal</span></a></li>
      </ul>
    </div>
    <figure class="hero__photo">
      <img src="/assets/img/mahmud.jpg" alt="Portrait of Mahmud Lawal" width="800" height="1000" fetchpriority="high" />
    </figure>
  </section>

  <div class="container">
    <ul class="highlights" aria-label="Highlights">
      {highlights.map((h) => (
        <li>
          <span class="label">{h.k}</span>
          <span>{h.v}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- ============ WORK ============ -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="label">Selected work</p>
        <h2 id="work-title">Projects &amp; competitions</h2>
        <p>End-to-end systems across autonomy, vision, and language — several battle-tested in hackathons and global competitions.</p>
      </header>
      <ul class="projects">
        {projects.map((p) => (
          <li class="project">
            <div class="project__meta">
              <span class={p.winner ? 'badge badge--accent' : 'badge'}>{p.badge}</span>
            </div>
            <div class="project__body">
              <h3>{p.title}</h3>
              {p.result && <p class="project__result">{p.result}</p>}
              <p class="project__summary">{p.summary}</p>
              <ul class="stack" aria-label="Stack">
                {p.stack.map((s) => <li>{s}</li>)}
              </ul>
              {p.links && p.links.length > 0 && (
                <ul class="project__links">
                  {p.links.map((l) => (
                    <li><a href={l.href} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section class="section" id="writing" aria-labelledby="writing-title">
    <span id="writing-teaser" class="anchor" aria-hidden="true"></span>
    <div class="container">
      <header class="section-head section-head--row">
        <div>
          <p class="label">Writing</p>
          <h2 id="writing-title">From the blog</h2>
          <p>Robotics concepts, one page at a time — the intuition in prose, the maths on a printable sheet.</p>
        </div>
        <a class="btn" href="/blog/">All writing <Fragment set:html={arrow} /></a>
      </header>
      <PostList posts={posts} />
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section" id="certifications" aria-labelledby="certs-title">
    <div class="container">
      <header class="section-head">
        <p class="label">Credentials</p>
        <h2 id="certs-title">Certifications &amp; specializations</h2>
        <p>Verified learning across autonomous vehicles, AI engineering, robotics, and software. Every Coursera certificate links to its verification page.</p>
      </header>
      <Credentials />
    </div>
  </section>

  <!-- ============ BACKGROUND + TOOLKIT ============ -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="about">
        <div>
          <header class="section-head">
            <p class="label">Background</p>
            <h2 id="about-title">Where perception meets control</h2>
          </header>
          <div class="about__body">
            <p>
              I'm a Mechatronics engineer who designs and ships <strong>end-to-end AI systems</strong>.
              My work sits where perception meets control: real-time object detection and tracking,
              image and video analytics, and deep-learning models optimized to run on constrained
              edge hardware.
            </p>
            <p>
              I led the <strong>Robotics &amp; Automation Division at RAIN-INN ABU</strong>, mentoring
              on ROS, computer vision, and model deployment. Along the way I've competed on global
              stages — autonomous programming, computer-vision challenges, and hackathons.
            </p>
            <p>This site is also where I explore writing.</p>
          </div>
        </div>
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt class="label">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="toolkit" id="skills">
        <h3 class="toolkit__title">Toolkit <span>— the stack I reach for across perception, learning, and deployment.</span></h3>
        <dl class="skills">
          {skills.map((s) => (
            <div class="skills__row">
              <dt>{s.group}</dt>
              <dd>
                <ul class="stack">
                  {s.items.map((it) => <li>{it}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container contact__inner">
      <p class="label">Get in touch</p>
      <h2 id="contact-title">Let's build something autonomous.</h2>
      <p>Open to roles and collaborations in robotics, computer vision, and applied AI.</p>
      <div class="contact__links">
        <a class="btn btn--primary" href={SITE.links.email}>{SITE.email}</a>
        <a class="btn" href={SITE.links.github} rel="noopener">GitHub</a>
        <a class="btn" href={SITE.links.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(32px, 5vw, 60px) clamp(28px, 4vw, 40px);
  }
  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 4.25rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 12px 0 20px;
  }
  .hero__lede { font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--text-2); max-width: 36em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero__links { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 24px 0 0; font-size: 0.9375rem; }
  .hero__links a { color: var(--text-2); text-decoration: none; }
  .hero__links a:hover { color: var(--accent); }
  .hero__links .mono { font-size: 0.8125rem; color: var(--text-3); }
  .hero__photo { margin: 0; width: clamp(180px, 20vw, 232px); }
  .hero__photo img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%;
    border-radius: var(--radius); border: 1px solid var(--line);
    filter: saturate(0.9);
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; }
    .hero__photo { order: -1; width: 112px; }
    .hero__photo { aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 1px solid var(--line); }
    /* Zoom in on the face for the round crop. */
    .hero__photo img { aspect-ratio: 1; border: 0; border-radius: 0; object-position: 50% 0; transform: scale(1.35); transform-origin: 50% 20%; }
  }

  .highlights {
    list-style: none; margin: 0 0 clamp(40px, 6vw, 64px); padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface);
  }
  .highlights li { display: grid; align-content: start; gap: 4px; padding: 16px 20px; font-size: 0.9375rem; }
  .highlights li + li { border-left: 1px solid var(--line); }
  .highlights li:first-child { box-shadow: inset 0 2px 0 var(--accent); }
  .highlights li:first-child .label { color: var(--accent); }
  @media (max-width: 960px) {
    .highlights { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .highlights li:nth-child(odd) { border-left: 0; }
    .highlights li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .highlights { grid-template-columns: 1fr; }
    .highlights li + li { border-left: 0; border-top: 1px solid var(--line); }
  }

  /* ---- Projects ---- */
  .projects { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .project {
    display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 8px 32px;
    padding-block: 28px; border-bottom: 1px solid var(--line);
  }
  .project__meta { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding-top: 4px; }
  .project h3 { font-size: 1.25rem; }
  .project__result { margin: 6px 0 0; font-size: 0.9375rem; font-weight: 500; color: var(--accent); }
  .project__links { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; padding: 0; margin: 12px 0 0; font-size: 0.875rem; }
  .project__links a { color: var(--text-2); }
  .project__summary { margin: 10px 0 14px; color: var(--text-2); max-width: 44em; }
  @media (max-width: 720px) {
    .project { grid-template-columns: 1fr; }
    .project__meta { flex-direction: row; align-items: center; }
  }

  /* ---- About ---- */
  .about { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .about__body { max-width: 40em; color: var(--text-2); }
  .about__body strong { color: var(--text); font-weight: 600; }
  .facts { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
  .facts dd { margin: 0; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } }

  /* ---- Toolkit (inside Background) ---- */
  .toolkit { margin-top: clamp(40px, 6vw, 64px); }
  .toolkit__title { font-size: 1.125rem; margin-bottom: 16px; }
  .toolkit__title span { font-weight: 400; color: var(--text-2); }
  .skills { margin: 0; border-top: 1px solid var(--line); }
  .skills__row {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 8px 32px;
    padding-block: 16px; border-bottom: 1px solid var(--line); align-items: baseline;
  }
  .skills dt { font-weight: 500; }
  .skills dd { margin: 0; }
  @media (max-width: 720px) { .skills__row { grid-template-columns: 1fr; } }

  /* ---- Writing ---- */
  #writing { position: relative; }
  .anchor { position: absolute; top: 0; }
  .section-head--row {
    max-width: none; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px;
  }
  .section-head--row > div { display: grid; gap: 8px; max-width: 720px; }

  /* ---- Contact ---- */
  .contact { background: var(--bg-2); }
  .contact__inner h2 { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); margin: 10px 0 12px; letter-spacing: -0.02em; }
  .contact__inner > p:not(.label) { color: var(--text-2); }
  .contact__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .contact__links .btn--primary { font-family: var(--font-mono); font-size: 0.875rem; overflow-wrap: anywhere; }
</style>
