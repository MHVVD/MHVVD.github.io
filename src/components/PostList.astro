---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, pad2, seriesLabel } from '../data/site';

interface Props {
  posts: CollectionEntry<'posts'>[];
  showTags?: boolean;
}
const { posts, showTags = false } = Astro.props;
---

<ol class="posts">
  {posts.map((p) => (
    <li class="post-row">
      <div class="post-row__meta label">
        <time datetime={p.data.created.toISOString()}>{fmtDate(p.data.created)}</time>
        {p.data.series && (
          <span>
            <span class="nowrap">{seriesLabel(p.data.series)}</span>
            {p.data.seriesNumber && <span class="nowrap"> · No.&nbsp;{pad2(p.data.seriesNumber)}</span>}
          </span>
        )}
        {p.data.readingTime && <span>{p.data.readingTime} read</span>}
      </div>
      <div>
        <h3 class="post-row__title">
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
        </h3>
        <p class="post-row__excerpt">{p.data.excerpt}</p>
        {showTags && p.data.tags.length > 0 && (
          <ul class="stack" aria-label="Tags">
            {p.data.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .post-row {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 8px 32px;
    padding-block: 24px; border-bottom: 1px solid var(--line); position: relative;
  }
  .post-row__meta { display: flex; flex-direction: column; gap: 4px; padding-top: 4px; }
  .post-row__meta > * { white-space: nowrap; }
  .post-row__title { font-size: 1.1875rem; }
  .post-row__title a { text-decoration: none; }
  .post-row__title a::after { content: ''; position: absolute; inset: 0; }
  .post-row:hover .post-row__title a { color: var(--accent); }
  .post-row__excerpt { color: var(--text-2); margin: 8px 0 0; max-width: 44em; }
  .post-row .stack { margin-top: 14px; position: relative; }
  @media (max-width: 720px) {
    .post-row { grid-template-columns: 1fr; }
    .post-row__meta { flex-direction: row; flex-wrap: wrap; gap: 4px 14px; }
    .post-row__meta > * { white-space: normal; }
    .nowrap { white-space: nowrap; }
  }
</style>
