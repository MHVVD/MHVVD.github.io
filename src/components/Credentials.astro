---
import CertTable from './CertTable.astro';
import { credentials, type CertDoc } from '../data/profile';

// Viewer groups: specialization certificate first, then each course (arrows cycle within a group).
type Doc = CertDoc & { label: string };
const groups: Record<string, Doc[]> = {};
for (const c of credentials) {
  if (!c.specialization) continue;
  const s = c.specialization;
  groups[c.id] = [
    { ...s, label: `${s.date} · ${s.courses}` },
    ...(c.courses ?? []).map((d) => ({ ...d, label: d.date })),
  ];
}
const featured = credentials.filter((c) => c.featured && c.specialization);
const compact = credentials.filter((c) => !(c.featured && c.specialization));
const ext = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
---

<div class="creds">
  {featured.map((c) => (
    <article class="cred">
      <div class="cred__media">
        <button type="button" class="cert-open cred__thumb" data-group={c.id} data-index="0" aria-label={`View certificate: ${c.specialization!.title}`}>
          <img src={c.specialization!.src} alt="" loading="lazy" width="640" height="495" />
        </button>
        <p class="label">{groups[c.id].length} certificates · click to view</p>
      </div>
      <div class="cred__body">
        <p class="label">{c.issuer}</p>
        <h3>{c.name}</h3>
        <p class="cred__desc">{c.desc}</p>
        <ul class="cred__skills">{c.skills.map((s) => <li>{s}</li>)}</ul>
        <CertTable id={c.id} name={c.name} courses={c.specialization!.courses} docs={groups[c.id]} />
      </div>
    </article>
  ))}

  <div class="creds__compact">
    {compact.map((c) => (
      <article class="cred cred--compact">
        <p class="label">{c.issuer}</p>
        <h3>{c.name}</h3>
        <p class="cred__desc">{c.desc}</p>
        <ul class="cred__skills">{c.skills.map((s) => <li>{s}</li>)}</ul>
        {c.specialization && (
          <div class="cred__more">
            <button type="button" class="btn cert-open" data-group={c.id} data-index="0">
              View {groups[c.id].length} certificates
            </button>
            <details>
              <summary>Courses &amp; verification links</summary>
              <CertTable id={c.id} name={c.name} courses={c.specialization.courses} docs={groups[c.id]} />
            </details>
          </div>
        )}
      </article>
    ))}
  </div>
</div>

<dialog class="viewer" id="cert-viewer" aria-labelledby="viewer-title">
  <div class="viewer__box">
    <div class="viewer__bar">
      <p class="viewer__title" id="viewer-title"></p>
      <button type="button" class="viewer__btn" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="viewer__stage">
      <img class="viewer__img" alt="" />
    </div>
    <div class="viewer__bar viewer__bar--foot">
      <button type="button" class="viewer__btn" data-step="-1" aria-label="Previous certificate">&larr;</button>
      <button type="button" class="viewer__btn" data-step="1" aria-label="Next certificate">&rarr;</button>
      <span class="mono viewer__count"></span>
      <span class="mono viewer__date"></span>
      <a class="viewer__verify" href="#" rel="noopener">Verify on Coursera <Fragment set:html={ext} /></a>
    </div>
  </div>
</dialog>

<script type="application/json" id="cert-data" set:html={JSON.stringify(groups)} />

<script>
  type Doc = { src: string; title: string; label: string; url: string };
  const data: Record<string, Doc[]> = JSON.parse(document.getElementById('cert-data')!.textContent!);
  const dlg = document.getElementById('cert-viewer') as HTMLDialogElement;
  const img = dlg.querySelector<HTMLImageElement>('.viewer__img')!;
  const title = dlg.querySelector<HTMLElement>('.viewer__title')!;
  const date = dlg.querySelector<HTMLElement>('.viewer__date')!;
  const count = dlg.querySelector<HTMLElement>('.viewer__count')!;
  const verify = dlg.querySelector<HTMLAnchorElement>('.viewer__verify')!;
  let group: Doc[] = [];
  let idx = 0;

  // Hide the image until the new one has loaded, so a stale certificate never shows.
  img.addEventListener('load', () => img.classList.add('is-ready'));
  const preload = (i: number) => { const d = group[(i + group.length) % group.length]; if (d) new Image().src = d.src; };

  const render = () => {
    const d = group[idx];
    if (!img.src.endsWith(d.src)) {
      img.classList.remove('is-ready');
      img.src = d.src;
      if (img.complete && img.naturalWidth) img.classList.add('is-ready');
    }
    img.alt = `Certificate: ${d.title}`;
    title.textContent = d.title;
    date.textContent = d.label;
    count.textContent = `${idx + 1} / ${group.length}`;
    verify.href = d.url;
    preload(idx + 1);
    preload(idx - 1);
  };
  const step = (n: number) => { idx = (idx + n + group.length) % group.length; render(); };

  document.querySelectorAll<HTMLButtonElement>('.cert-open').forEach((b) =>
    b.addEventListener('click', () => {
      group = data[b.dataset.group!] ?? [];
      if (!group.length) return;
      idx = Number(b.dataset.index) || 0;
      render();
      dlg.showModal();
    }),
  );
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => step(Number(b.dataset.step))),
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>

<style>
  .creds { display: grid; gap: 20px; }
  .cred {
    container: cred / inline-size;
    display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 20px 36px;
    padding: clamp(18px, 3vw, 28px); background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .cred h3 { font-size: 1.1875rem; margin: 6px 0 10px; }
  .cred__desc { color: var(--text-2); font-size: 0.9688rem; }
  .cred__media { display: grid; gap: 10px; align-content: start; }
  .cred__thumb {
    padding: 0; border: 1px solid var(--line); border-radius: 4px; background: #fff; cursor: zoom-in;
    overflow: hidden; display: block; width: 100%;
  }
  .cred__thumb img { width: 100%; aspect-ratio: 1024 / 791; object-fit: cover; }
  .cred__thumb:hover { border-color: var(--accent); }
  .cred__body { container: cred / inline-size; }
  .cred__skills {
    list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 4px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); font-size: 0.9063rem; color: var(--text-2);
  }
  .cred__skills li { padding-left: 14px; position: relative; }
  .cred__skills li::before { content: ''; position: absolute; left: 0; top: calc(0.8em - 1px); width: 6px; height: 2px; background: var(--accent); }

  .creds__compact { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .cred--compact { display: flex; flex-direction: column; gap: 0; }
  .cred .label { margin: 0; }
  .cred--compact .cred__skills { margin: 0; grid-template-columns: 1fr; }
  .cred__more { margin-top: auto; padding-top: 18px; }
  .cred__more .btn { font-size: 0.875rem; padding: 7px 12px; }
  .cred__more details { margin-top: 12px; }
  .cred__more summary { cursor: pointer; font-size: 0.875rem; color: var(--text-2); margin-bottom: 8px; }
  .cred__more summary:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .cred { grid-template-columns: 1fr; }
    .cred__media { max-width: 360px; }
  }

  /* ---- Viewer ---- */
  /* Fixed aspect-ratio stage (all certificates are 1.294:1) so the dialog never jumps in height. */
  .viewer {
    --ratio: 1.2946;
    padding: 0; border: 0; background: transparent;
    width: min(1100px, 100vw - 24px, (100dvh - 150px) * var(--ratio) + 26px);
    max-width: none; max-height: calc(100dvh - 24px);
  }
  .viewer::backdrop { background: rgb(8 10 12 / 0.82); }
  .viewer__box {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    display: grid; overflow: hidden;
  }
  .viewer__bar { display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 16px; border-bottom: 1px solid var(--line); }
  .viewer__bar--foot { border-bottom: 0; border-top: 1px solid var(--line); padding-left: 12px; flex-wrap: wrap; }
  .viewer__title { margin: 0; font-weight: 600; flex: 1; min-width: 0; line-height: 1.35; }
  /* Reserve two lines on narrow screens so long titles don't change the dialog height */
  @media (max-width: 720px) {
    .viewer__title {
      min-height: 2.7em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
    }
  }
  .viewer__stage { background: var(--bg-2); padding: 12px; }
  .viewer__img {
    width: 100%; aspect-ratio: 1024 / 791; object-fit: contain;
    opacity: 0; transition: opacity 0.12s linear;
  }
  .viewer__img.is-ready { opacity: 1; }
  .viewer__btn {
    display: inline-grid; place-items: center; width: 36px; height: 36px; flex: none;
    border: 1px solid var(--line); border-radius: var(--radius); background: transparent; color: var(--text);
    cursor: pointer; font-size: 1.1rem;
  }
  .viewer__btn:hover { border-color: var(--text); }
  .viewer__btn svg { width: 18px; height: 18px; }
  .viewer__date, .viewer__count { font-size: 0.8125rem; color: var(--text-3); }
  .viewer__date { margin-right: auto; }
  .viewer__verify { white-space: nowrap; display: inline-flex; align-items: center; gap: 4px; font-size: 0.875rem; font-weight: 500; }
  .viewer__verify :global(svg) { width: 13px; height: 13px; flex: none; }
</style>
