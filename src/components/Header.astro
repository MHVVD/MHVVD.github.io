---
const path = Astro.url.pathname;
const inBlog = path.startsWith('/blog');
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">Mahmud Lawal<span>.</span></a>
    <div class="nav__right">
      <nav aria-label="Primary">
        <ul class="nav__links">
          <li><a href="/#work">Work</a></li>
          <li><a href="/blog/" aria-current={inBlog ? 'page' : undefined}>Writing</a></li>
          <li>
            <a href="/#contact" class="nav__contact" aria-label="Contact">
              <span class="nav__contact-text">Contact</span>
              <svg class="nav__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
            </a>
          </li>
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const current = () =>
    root.getAttribute('data-theme') ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const sync = () => btn?.setAttribute('aria-pressed', String(current() === 'dark'));
  sync();
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    (window as unknown as { __applyTheme: (t: string) => void }).__applyTheme(next);
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>
